{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Comparison cases manifest",
  "type": "object",
  "required": ["cases"],
  "properties": {
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "skill", "label", "viewport"],
        "properties": {
          "id": { "type": "string" },
          "skill": { "type": "string" },
          "label": { "type": "string" },
          "viewport": {
            "type": "object",
            "required": ["width", "height"],
            "properties": {
              "width": { "type": "integer", "minimum": 320 },
              "height": { "type": "integer", "minimum": 200 }
            }
          },
          "fullPage": { "type": "boolean", "default": false }
        }
      }
    }
  }
}
