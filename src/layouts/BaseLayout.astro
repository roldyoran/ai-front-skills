---
import '@/styles/global.css';
import SEO from '@/components/shared/SEO.astro';
import SkipLink from '@/components/shared/SkipLink.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import { getLocaleFromPath } from '@/lib/i18n';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const {
  title = 'Front Skills',
  description = 'Frontend skills with visual before/after comparisons',
  image,
  type,
} = Astro.props;

const locale = getLocaleFromPath(Astro.url.pathname);
---

<!doctype html>
<html lang={locale} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SEO title={title} description={description} image={image} type={type} />
  </head>
  <body class="min-h-screen bg-background text-text-secondary font-mono antialiased">
    <SkipLink />
    <Header />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    padding: 0;
    width: 100%;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  body {
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
  }
</style>
