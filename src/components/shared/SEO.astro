---
import { getLocaleUrl, locales, defaultLocale, type Locale } from '@/lib/i18n';

interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalURL?: string;
  type?: 'website' | 'article';
}

const {
  title,
  description,
  image = '/og-default.png',
  canonicalURL,
  type = 'website',
} = Astro.props;

const siteTitle = 'Front Skills';
const fullTitle = title === siteTitle ? title : `${title} | ${siteTitle}`;
const currentURL = canonicalURL || Astro.url.href;
// Only absolute/resolvable images — no broken default (there is no og-default.png in public/)
const imageURL = image ? new URL(image, Astro.site).href : undefined;

// hreflang alternates for every locale + x-default (points at the default locale URL)
const alternates = locales.map((locale: Locale) => ({
  hreflang: locale,
  href: new URL(getLocaleUrl(Astro.url.pathname, locale), Astro.site).href,
}));
const xDefaultHref = new URL(getLocaleUrl(Astro.url.pathname, defaultLocale), Astro.site).href;
---

<!-- Primary Meta -->
<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="generator" content={Astro.generator} />
<link rel="canonical" href={currentURL} />
{alternates.map(({ hreflang, href }) => (
  <link rel="alternate" hreflang={hreflang} href={href} />
))}
<link rel="alternate" hreflang="x-default" href={xDefaultHref} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:url" content={currentURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
{imageURL && <meta property="og:image" content={imageURL} />}
<meta property="og:site_name" content={siteTitle} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={currentURL} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
{imageURL && <meta name="twitter:image" content={imageURL} />}

<!-- JSON-LD Structured Data -->
<script
  type="application/ld+json"
  set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: siteTitle,
    description,
    url: currentURL,
  })}
/>
