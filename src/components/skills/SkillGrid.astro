---
import type { Skill } from '@/lib/skills';
import SkillCard from './SkillCard.astro';

interface Props {
  skills: Skill[];
  locale?: 'es' | 'en';
  variant?: 'list' | 'card';
}

const { skills, locale = 'es', variant = 'card' } = Astro.props;
---

{skills.length > 0 ? (
  <div class={variant === 'list' ? 'flex flex-col' : 'flex flex-col gap-2'}>
    {skills.map((skill) => (
      <SkillCard skill={skill} locale={locale} variant={variant} />
    ))}
  </div>
) : (
  <div class="text-center py-12">
    <p class="text-text-muted">No skills found</p>
  </div>
)}
