---
import type { Skill } from '@/lib/skills';
import SkillCard from './SkillCard.astro';

interface Props {
  skills: Skill[];
  locale?: 'es' | 'en';
  columns?: 2 | 3;
}

const { skills, locale = 'es', columns = 3 } = Astro.props;

const gridCols: Record<number, string> = {
  2: 'grid-cols-1 sm:grid-cols-2',
  3: 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3',
};
---

{skills.length > 0 ? (
  <div class={`grid gap-6 ${gridCols[columns]}`}>
    {skills.map((skill) => (
      <SkillCard skill={skill} locale={locale} />
    ))}
  </div>
) : (
  <div class="text-center py-12">
    <p class="text-text-muted">No skills found</p>
  </div>
)}
