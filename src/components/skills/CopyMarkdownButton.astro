---
import { Button } from '@/components/starwind/button';
import Icon from '@/components/ui/Icon.astro';

interface Props {
  markdown: string;
  copyLabel?: string;
  copiedLabel?: string;
  copiedMessage?: string;
}

const {
  markdown,
  copyLabel = 'Copy markdown',
  copiedLabel = 'Copied',
  copiedMessage = 'Skill markdown copied to clipboard',
} = Astro.props;
---

<span
  class="inline-flex"
  data-copy-markdown
  data-markdown={markdown}
  data-copy-label={copyLabel}
  data-copied-label={copiedLabel}
  data-copied-message={copiedMessage}
>
  <Button variant="outline" size="sm" data-copy-btn class="shrink-0">
    <span data-copy-icon-copy class="inline-flex">
      <Icon name="copy" size={14} />
    </span>
    <span data-copy-icon-check class="hidden items-center text-success">
      <Icon name="check" size={14} />
    </span>
    <span data-copy-text>{copyLabel}</span>
  </Button>
  <span class="sr-only" role="status" data-copy-status></span>
</span>

<script>
  import { toast } from '@/components/starwind/toast';

  const SUCCESS_MS = 2000;

  async function writeClipboard(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      // Fallback for non-secure contexts / older browsers
      try {
        const area = document.createElement('textarea');
        area.value = text;
        area.setAttribute('readonly', '');
        area.style.position = 'fixed';
        area.style.opacity = '0';
        document.body.appendChild(area);
        area.select();
        const ok = document.execCommand('copy');
        document.body.removeChild(area);
        return ok;
      } catch {
        return false;
      }
    }
  }

  function initCopyMarkdownButtons() {
    document.querySelectorAll<HTMLElement>('[data-copy-markdown]').forEach((root) => {
      if (root.dataset.initialized === 'true') return;
      root.dataset.initialized = 'true';

      const btn = root.querySelector<HTMLButtonElement>('[data-copy-btn]');
      const iconCopy = root.querySelector('[data-copy-icon-copy]');
      const iconCheck = root.querySelector('[data-copy-icon-check]');
      const label = root.querySelector('[data-copy-text]');
      const status = root.querySelector('[data-copy-status]');
      if (!btn || !iconCopy || !iconCheck || !label) return;

      const markdown = root.dataset.markdown ?? '';
      const copyLabel = root.dataset.copyLabel ?? 'Copy markdown';
      const copiedLabel = root.dataset.copiedLabel ?? 'Copied';
      const msg = root.dataset.copiedMessage ?? 'Copied';
      let timer: ReturnType<typeof setTimeout> | undefined;

      const setState = (copied: boolean) => {
        iconCopy.classList.toggle('hidden', copied);
        iconCopy.classList.toggle('inline-flex', !copied);
        iconCheck.classList.toggle('hidden', !copied);
        iconCheck.classList.toggle('inline-flex', copied);
        label.textContent = copied ? copiedLabel : copyLabel;
        btn.setAttribute('aria-label', copied ? copiedLabel : copyLabel);
        btn.dataset.copied = copied ? 'true' : 'false';
        if (status) status.textContent = copied ? msg : '';
      };

      btn.addEventListener('click', async () => {
        const ok = await writeClipboard(markdown);
        if (!ok) {
          toast.error(msg);
          return;
        }
        toast.success(msg);
        setState(true);
        if (timer) clearTimeout(timer);
        timer = setTimeout(() => setState(false), SUCCESS_MS);
      });
    });
  }

  initCopyMarkdownButtons();
  document.addEventListener('astro:page-load', initCopyMarkdownButtons);
</script>

<style>
  [data-copy-btn][data-copied='true'] {
    border-color: var(--color-success);
    color: var(--color-success);
  }
</style>
