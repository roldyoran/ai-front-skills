---
interface Props {
  skill: Skill;
  locale?: 'es' | 'en';
}

import type { Skill } from '@/lib/skills';
import { getCategoryInfo } from '@/lib/skills';

const { skill, locale = 'en' } = Astro.props;
const { title, slug, category, description, tags, author, comparison } = skill.data;
const categoryInfo = getCategoryInfo(category, locale);

const skillUrl = locale === 'es' ? `/es/skills/${slug}` : `/skills/${slug}`;
const hasComparison = comparison?.before && comparison?.after;

// Generate initials from author name
const initials = author
  .split(/[\s_-]+/)
  .map((w) => w[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();
---

<a
  href={skillUrl}
  class="group flex flex-col h-full border border-border bg-surface p-4 transition-all duration-200 hover:border-border-hover hover:bg-surface-hover"
>
  <div class="flex flex-col flex-1 space-y-2.5">
    <!-- Title + Compare badge -->
    <div class="flex items-start justify-between gap-2 min-h-[2.5rem]">
      <h3 class="text-sm font-semibold text-text group-hover:text-text-secondary transition-colors leading-snug">
        {title}
      </h3>
      {hasComparison && (
        <span class="shrink-0 inline-flex items-center gap-1 text-[9px] text-text-dim border border-border px-1.5 py-0.5" title="Has before/after comparison">
          <svg class="w-2.5 h-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width={2}>
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
          </svg>
          Compare
        </span>
      )}
    </div>

    <!-- Description -->
    <p class="text-xs text-text-muted line-clamp-2 leading-relaxed">
      {description}
    </p>

    <!-- Tags -->
    {tags.length > 0 && (
      <div class="flex flex-wrap gap-1">
        {tags.slice(0, 3).map((tag) => (
          <span class="text-[10px] text-text-dim">#{tag}</span>
        ))}
      </div>
    )}

    <!-- Spacer -->
    <div class="flex-1"></div>

    <!-- Author (always at bottom) -->
    <div class="flex items-center gap-2 pt-2 mt-auto border-t border-border">
      <div class="w-5 h-5 flex items-center justify-center bg-bg-secondary border border-border text-[9px] font-bold text-text-secondary shrink-0">
        {initials}
      </div>
      <span class="text-[11px] text-text-dim truncate">{author}</span>
    </div>
  </div>
</a>
