---
import Icon from '@/components/ui/Icon.astro';
import SearchCommand from '@/components/svelte/SearchCommand.svelte';
import { getAllContentSkills } from '@/lib/skills';
import { t, getLocaleFromPath, getAlternateLocaleUrl } from '@/lib/i18n';

const locale = getLocaleFromPath(Astro.url.pathname);
const currentPath = Astro.url.pathname;
const altUrl = getAlternateLocaleUrl(Astro.url.pathname);

const contentSkills = await getAllContentSkills();

const searchData = contentSkills.map((s) => ({
  title: s.data.title,
  slug: s.data.slug,
  category: s.data.category,
  description: s.data.description,
}));

const prefix = locale === 'es' ? '/es' : '';

const searchLabels = {
  trigger: t('search.trigger', locale),
  placeholder: t('search.placeholder', locale),
  noResults: t('search.noResults', locale),
  navigate: t('search.navigate', locale),
  select: t('search.select', locale),
  close: t('search.close', locale),
  results: t('search.results', locale),
};

const navLinks: { href: string; label: string }[] = [
  { href: `${prefix}/`, label: t('nav.home', locale) },
  { href: `${prefix}/skills`, label: t('nav.skills', locale) },
];

function isActive(href: string): boolean {
  if (href === '/' || href === '/es') {
    return currentPath === href || currentPath === href + '/';
  }
  return currentPath.startsWith(href);
}
---

<header class="absolute inset-x-0 top-0 z-10 grid grid-cols-[1fr_auto_1fr] items-center px-4 pt-5 sm:px-8">
  <!-- Logo -->
  <a href={prefix || '/'} class="flex items-center gap-2 text-text hover:text-text-secondary transition-colors justify-self-start">
    <span class="font-bold text-base tracking-tight">&lt;fs/&gt;</span>
  </a>

  <!-- Nav (desktop) -->
  <nav class="hidden md:flex items-center gap-1 justify-self-center">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class:list={[
          'px-2.5 py-1.5 text-[13px] font-medium transition-colors rounded-md',
          isActive(link.href)
            ? 'text-text bg-surface'
            : 'text-text-muted hover:text-text-secondary hover:bg-surface-hover',
        ]}
      >
        {link.label}
      </a>
    ))}
  </nav>

  <!-- Actions -->
  <div class="flex items-center gap-1 justify-self-end">
    <SearchCommand client:load skills={searchData} locale={locale} labels={searchLabels} />

    <a
      href={altUrl}
      class="inline-flex items-center px-2.5 py-1.5 text-[13px] font-medium text-text-muted hover:text-text-secondary transition-colors hover:bg-surface-hover rounded-[6px]"
      title={locale === 'en' ? 'Cambiar a Español' : 'Switch to English'}
    >
      {locale === 'en' ? 'ES' : 'EN'}
    </a>

    <a
      href="https://github.com/front-skills"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center px-2.5 py-1.5 text-[13px] font-medium text-text-muted hover:text-text-secondary transition-colors hover:bg-surface-hover rounded-[6px]"
      aria-label="GitHub"
    >
      <Icon name="github" size={16} />
    </a>
  </div>
</header>
