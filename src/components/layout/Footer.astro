---
import { getTopics, getAllSkills } from '@/lib/skills';

const topics = await getTopics();
const featuredSkills = await getAllSkills({ featured: true });
---

<footer class="border-t border-border">
  <div class="container-page py-12">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      <!-- Topics -->
      <div>
        <h3 class="text-xs font-bold text-text-muted uppercase tracking-wider mb-4">Topics</h3>
        <ul class="space-y-2">
          {topics.map(({ topic, count }) => (
            <li>
              <a
                href={`/skills?topic=${encodeURIComponent(topic)}`}
                class="text-[13px] text-text-secondary hover:text-text transition-colors"
              >
                {topic}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Best skills -->
      <div>
        <h3 class="text-xs font-bold text-text-muted uppercase tracking-wider mb-4">Best skills</h3>
        <ul class="space-y-2">
          {featuredSkills.slice(0, 7).map((skill) => (
            <li>
              <a
                href={`/skills/${skill.data.slug}`}
                class="text-[13px] text-text-secondary hover:text-text transition-colors"
              >
                {skill.data.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- More -->
      <div>
        <h3 class="text-xs font-bold text-text-muted uppercase tracking-wider mb-4">More</h3>
        <ul class="space-y-2">
          <li>
            <a
              href="https://github.com/front-skills"
              target="_blank"
              rel="noopener noreferrer"
              class="text-[13px] text-text-secondary hover:text-text transition-colors"
            >
              GitHub
            </a>
          </li>
          <li>
            <a
              href="/skills"
              class="text-[13px] text-text-secondary hover:text-text transition-colors"
            >
              All skills
            </a>
          </li>
        </ul>
      </div>

      <!-- Brand -->
      <div>
        <a href="/" class="text-text hover:text-text-secondary transition-colors">
          <span class="font-bold text-base tracking-tight">&lt;fs/&gt;</span>
        </a>
        <p class="mt-3 text-[12px] text-text-dim leading-relaxed">
          Frontend skills with visual before/after comparisons.
        </p>
        <div class="mt-4 flex items-center gap-3">
          <a
            href="https://github.com/front-skills"
            target="_blank"
            rel="noopener noreferrer"
            class="text-text-muted hover:text-text transition-colors"
            aria-label="GitHub"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
              <path d="M9 18c-4.51 2-5-2-7-2"/>
            </svg>
          </a>
          <a
            href="https://x.com/ibelick"
            target="_blank"
            rel="noopener noreferrer"
            class="text-text-muted hover:text-text transition-colors"
            aria-label="X (Twitter)"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4l11.733 16h4.267l-11.733 -16h-4.267z"/>
              <path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"/>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Copyright -->
    <div class="mt-10 pt-6 border-t border-border">
      <p class="text-[11px] text-text-dim text-center">
        &copy; {new Date().getFullYear()} Front Skills
      </p>
    </div>
  </div>
</footer>
