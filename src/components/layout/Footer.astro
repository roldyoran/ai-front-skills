---
import Icon from '@/components/ui/Icon.astro';
import { Separator } from '@/components/starwind/separator';
import { getTopics, getAllSkills, topicSlug } from '@/lib/skills';
import { getLocalePrefix, t, type Locale } from '@/lib/i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const prefix = getLocalePrefix(locale);

const topics = await getTopics();
const featuredSkills = await getAllSkills({ featured: true });
---

<footer class="border-t border-border">
  <div class="container-page py-12">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      <!-- Topics -->
      <div>
        <h3 class="text-xs font-bold text-text-muted uppercase tracking-wider mb-4">{t('footer.topics', locale)}</h3>
        <ul class="space-y-2">
          {topics.map(({ topic, count }) => (
            <li>
              <a
                href={`${prefix}/skills?topic=${topicSlug(topic)}`}
                class="text-[13px] text-text-secondary hover:text-text transition-colors"
              >
                {topic}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Best skills -->
      <div>
        <h3 class="text-xs font-bold text-text-muted uppercase tracking-wider mb-4">{t('footer.bestSkills', locale)}</h3>
        <ul class="space-y-2">
          {featuredSkills.slice(0, 7).map((skill) => (
            <li>
              <a
                href={`${prefix}/skills/${skill.data.slug}`}
                class="text-[13px] text-text-secondary hover:text-text transition-colors"
              >
                {skill.data.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Resources -->
      <div>
        <h3 class="text-xs font-bold text-text-muted uppercase tracking-wider mb-4">{t('footer.resources', locale)}</h3>
        <ul class="space-y-2">
          <li>
            <a
              href={`${prefix}/`}
              class="text-[13px] text-text-secondary hover:text-text transition-colors"
            >
              {t('nav.home', locale)}
            </a>
          </li>
          <li>
            <a
              href={`${prefix}/skills`}
              class="text-[13px] text-text-secondary hover:text-text transition-colors"
            >
              {t('footer.allSkills', locale)}
            </a>
          </li>
          <li>
            <a
              href="https://github.com/front-skills"
              target="_blank"
              rel="noopener noreferrer"
              class="text-[13px] text-text-secondary hover:text-text transition-colors"
            >
              GitHub
            </a>
          </li>
        </ul>
      </div>

      <!-- Brand -->
      <div>
        <a href={prefix || '/'} class="text-text hover:text-text-secondary transition-colors">
          <span class="font-bold text-base tracking-tight">&lt;fs/&gt;</span>
        </a>
        <p class="mt-3 text-[12px] text-text-muted leading-relaxed">
          {t('site.description', locale)}
        </p>
        <div class="mt-4 flex items-center gap-3">
          <a
            href="https://github.com/front-skills"
            target="_blank"
            rel="noopener noreferrer"
            class="text-text-muted hover:text-text transition-colors"
            aria-label="GitHub"
          >
            <Icon name="github" size={16} />
          </a>
        </div>
      </div>
    </div>

    <!-- Copyright -->
    <div class="mt-10">
      <Separator class="mb-6" />
      <p class="text-[11px] text-text-muted text-center">
        &copy; {new Date().getFullYear()} Front Skills
      </p>
    </div>
  </div>
</footer>
