---
interface Props {
  variant?: 'default' | 'category';
  size?: 'sm' | 'md';
  class?: string;
}

const {
  variant = 'default',
  size = 'sm',
  class: className = '',
} = Astro.props;

const baseStyles = 'inline-flex items-center font-medium whitespace-nowrap';

const variants: Record<string, string> = {
  default: 'bg-surface text-text-secondary border border-border',
  category: 'bg-background-tertiary text-text-primary border border-border',
};

const sizes: Record<string, string> = {
  sm: 'px-2 py-0.5 text-xs',
  md: 'px-2.5 py-1 text-sm',
};
---

<span class:list={[baseStyles, variants[variant], sizes[size], className]}>
  <slot />
</span>
