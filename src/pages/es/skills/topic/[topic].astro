---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SkillGrid from '@/components/skills/SkillGrid.astro';
import {
  Breadcrumb,
  BreadcrumbList,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from '@/components/starwind/breadcrumb';
import { Badge } from '@/components/starwind/badge';
import { Separator } from '@/components/starwind/separator';
import { getAllSkills, getTopics, topicSlug } from '@/lib/skills';
import { t } from '@/lib/i18n';

export async function getStaticPaths() {
  const topics = await getTopics();
  return topics.map(({ topic }) => ({
    params: { topic: topicSlug(topic) },
    props: { topicName: topic },
  }));
}

const locale = 'es' as const;
const { topicName } = Astro.props;
const allSkills = await getAllSkills();
const topics = await getTopics();
const skills = allSkills.filter((s) =>
  s.data.topics.some((x) => topicSlug(x) === Astro.params.topic),
);
const topicSkillsUrl = (name: string) => `/es/skills/topic/${topicSlug(name)}`;
---

<BaseLayout
  title={`Skills de ${topicName} - Front Skills`}
  description={`Skills de frontend sobre ${topicName}`}
>
  <div class="container-page pt-24 pb-12">
    <Breadcrumb class="mb-6">
      <BreadcrumbList>
        <BreadcrumbItem>
          <BreadcrumbLink href="/es/">Inicio</BreadcrumbLink>
        </BreadcrumbItem>
        <BreadcrumbSeparator />
        <BreadcrumbItem>
          <BreadcrumbLink href="/es/skills">{t('skills.title', locale)}</BreadcrumbLink>
        </BreadcrumbItem>
        <BreadcrumbSeparator />
        <BreadcrumbItem>
          <BreadcrumbPage>{topicName}</BreadcrumbPage>
        </BreadcrumbItem>
      </BreadcrumbList>
    </Breadcrumb>

    <h1 class="page-title">{topicName}</h1>
    <p class="page-subtitle">{skills.length} {t('skills.countSuffix', locale)}</p>

    <div class="mt-6 flex flex-wrap gap-2">
      {topics.map(({ topic, count }) => (
        <a href={topicSkillsUrl(topic)}>
          <Badge variant={topic === topicName ? 'default' : 'outline'} size="md">
            {topic} ({count})
          </Badge>
        </a>
      ))}
    </div>

    <Separator class="my-8" />

    <SkillGrid skills={skills} locale={locale} />
  </div>
</BaseLayout>
