---
import BaseLayout from '@/layouts/BaseLayout.astro';
import InstallTabs from '@/components/skills/InstallTabs.astro';
import CopyMarkdownButton from '@/components/skills/CopyMarkdownButton.astro';
import SkillGrid from '@/components/skills/SkillGrid.astro';
import AuthorAvatar from '@/components/skills/AuthorAvatar.astro';
import ComparisonAttribution from '@/components/skills/ComparisonAttribution.astro';
import Icon from '@/components/ui/Icon.astro';
import ImageComparison from '@/components/svelte/ImageComparison.svelte';
import { Button } from '@/components/starwind/button';
import { Tabs, TabsList, TabsTrigger, TabsContent } from '@/components/starwind/tabs';
import {
  Breadcrumb,
  BreadcrumbList,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from '@/components/starwind/breadcrumb';
import { Badge } from '@/components/starwind/badge';
import { Separator } from '@/components/starwind/separator';
import { Prose } from '@/components/starwind/prose';
import { getAllSkills, getComparisonCases, getRelatedSkills, getPrevNextSkills, renderMarkdown } from '@/lib/skills';
import { t } from '@/lib/i18n';

export async function getStaticPaths() {
  const skills = await getAllSkills();
  return skills.map((skill) => ({
    params: { slug: skill.data.slug },
    props: { skill },
  }));
}

const { skill } = Astro.props;
const locale = 'es' as const;
const { title, slug, description, author, topics, image } = skill.data;
const comparisonCases = getComparisonCases(slug);

// Render markdown body
const contentHtml = renderMarkdown(skill.body);

const installPkg = `front-skills@${slug}`;

const relatedSkills = await getRelatedSkills(slug, 4);
const { prev: prevSkill, next: nextSkill } = await getPrevNextSkills(slug);
---

<BaseLayout
  title={`${title} - Front Skills`}
  description={description}
  image={comparisonCases[0]?.after}
  type="article"
>
  <article class="container-page pt-24 pb-12">
    <Breadcrumb class="mb-6">
      <BreadcrumbList>
        <BreadcrumbItem>
          <BreadcrumbLink href="/es/">Inicio</BreadcrumbLink>
        </BreadcrumbItem>
        <BreadcrumbSeparator />
        <BreadcrumbItem>
          <BreadcrumbLink href="/es/skills">Skills</BreadcrumbLink>
        </BreadcrumbItem>
        <BreadcrumbSeparator />
        <BreadcrumbItem>
          <BreadcrumbPage>{title}</BreadcrumbPage>
        </BreadcrumbItem>
      </BreadcrumbList>
    </Breadcrumb>

    <!-- Header -->
    <header class="mb-6">
      <div class="flex flex-wrap items-center gap-1.5 mb-3">
        {topics.map((topic) => (
          <Badge variant="secondary" size="sm">{topic}</Badge>
        ))}
        <span class="inline-flex items-center gap-1.5 ml-1">
          <AuthorAvatar author={author} variant="sm" src={image} />
          <span class="text-[11px] text-text-muted">{author}</span>
        </span>
      </div>

      <h1 class="text-2xl sm:text-3xl font-bold text-text tracking-tight mb-3">
        {title}
      </h1>

      <p class="text-sm text-text-secondary leading-relaxed">
        {description}
      </p>
    </header>

    <Separator class="mb-8" />

    <Tabs defaultValue="overview" class="mb-8">
      {comparisonCases.length > 0 && (
        <TabsList class="w-full justify-start gap-0.5 border border-border-subtle bg-bg-secondary p-0.5">
          <TabsTrigger value="overview" class="px-2.5 py-1 text-xs">{t('comparison.overviewTab', locale)}</TabsTrigger>
          <TabsTrigger value="comparisons" class="px-2.5 py-1 text-xs">
            {t('comparison.comparisonsTab', locale)} ({comparisonCases.length})
          </TabsTrigger>
        </TabsList>
      )}

      <!-- Installation -->
      <section class={comparisonCases.length > 0 ? "mb-8 mt-6" : "mb-8"}>
        <h2 class="mb-3 text-xs font-semibold text-text uppercase tracking-wider">
          {t('detail.installation', locale)}
        </h2>
        <InstallTabs
          pkg={installPkg}
          copyLabel={t('detail.copy', locale)}
          copiedLabel={t('detail.copiedLabel', locale)}
          copiedMessage={t('detail.copied', locale)}
        />
      </section>

      <TabsContent value="overview">
        <!-- SKILL.md Content -->
        {contentHtml && (
          <section>
            <div class="mb-4 flex flex-wrap items-center justify-between gap-2">
              <h2 class="text-xs font-semibold text-text uppercase tracking-wider">SKILL.md</h2>
              <CopyMarkdownButton
                markdown={skill.body}
                copyLabel={t('detail.copyMarkdown', locale)}
                copiedLabel={t('detail.copiedLabel', locale)}
                copiedMessage={t('detail.copied', locale)}
              />
            </div>
            <Prose set:html={contentHtml} />
          </section>
        )}
      </TabsContent>

      {comparisonCases.length > 0 && (
        <TabsContent value="comparisons">
          <p class="mb-4 text-xs text-text-secondary">{t('comparison.dragHint', locale)}</p>
          <div class="mb-6 flex flex-wrap gap-2">
            <Button as="a" href={comparisonCases[0].demoBefore} target="_blank" rel="noopener" variant="outline" size="sm">
              {t('comparison.beforeFull', locale)}
              <Icon name="external-link" size={12} />
            </Button>
            <Button as="a" href={comparisonCases[0].demoAfter} target="_blank" rel="noopener" variant="outline" size="sm">
              {t('comparison.afterFull', locale)}
              <Icon name="external-link" size={12} />
            </Button>
          </div>
          {comparisonCases.map((c) => (
            <div class="mb-8 last:mb-0">
              {comparisonCases.length > 1 && (
                <h3 class="mb-2 text-sm font-semibold text-text">{c.label}</h3>
              )}
              <ImageComparison
                client:visible
                beforeSrc={c.before}
                afterSrc={c.after}
                beforeAlt={`${title} — ${c.label} — ${t('comparison.before', locale)}`}
                afterAlt={`${title} — ${c.label} — ${t('comparison.after', locale)}`}
                beforeLabel={t('comparison.before', locale)}
                afterLabel={t('comparison.after', locale)}
                width={c.width}
                height={c.height}
              />
              {(c.beforeInfo.model || c.afterInfo.model) && (
                <div class="mt-2 space-y-1.5">
                  <ComparisonAttribution info={c.beforeInfo} kind="before" locale={locale} />
                  <ComparisonAttribution info={c.afterInfo} kind="after" locale={locale} />
                </div>
              )}
            </div>
          ))}
        </TabsContent>
      )}
    </Tabs>

    <!-- Related -->
    {relatedSkills.length > 0 && (
      <section>
        <Separator class="mb-8" />
        <h2 class="mb-4 text-xs font-semibold text-text uppercase tracking-wider">
          {t('detail.related', locale)}
        </h2>
        <SkillGrid skills={relatedSkills} locale={locale} variant="list" />
      </section>
    )}

    {(prevSkill || nextSkill) && (
      <nav class="mt-8 flex items-center justify-between gap-2" aria-label="Skill navigation">
        {prevSkill ? (
          <a href={`/es/skills/${prevSkill.data.slug}`} class="inline-flex min-w-0 items-center gap-2 text-xs text-text-muted hover:text-text">
            <span aria-hidden="true">←</span>
            <span class="truncate">{prevSkill.data.title}</span>
          </a>
        ) : <span />}
        {nextSkill ? (
          <a href={`/es/skills/${nextSkill.data.slug}`} class="inline-flex min-w-0 items-center gap-2 text-xs text-text-muted hover:text-text">
            <span class="truncate">{nextSkill.data.title}</span>
            <span aria-hidden="true">→</span>
          </a>
        ) : <span />}
      </nav>
    )}
  </article>
</BaseLayout>
