---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SkillGrid from '@/components/skills/SkillGrid.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import TopicFilter from '@/components/ui/TopicFilter.astro';
import { getAllSkills, getTopics } from '@/lib/skills';
import { t } from '@/lib/i18n';

const locale = 'es' as const;
const allSkills = await getAllSkills();
const topics = await getTopics();

const urlTopic = Astro.url.searchParams.get('topic') as string | null;

let filteredSkills = allSkills;
if (urlTopic) {
  filteredSkills = filteredSkills.filter(s =>
    s.data.topics.some(t => t.toLowerCase() === urlTopic.toLowerCase())
  );
}
---

<BaseLayout
  title={`${t('skills.title', locale)} - Front Skills`}
  description="Explora todas las skills de frontend disponibles"
>
  <div class="container-page pt-24 pb-12">
    <PageHeader
      title={t('skills.title', locale)}
      subtitle={`${filteredSkills.length} skills disponibles`}
    />

    <TopicFilter topics={topics} activeTopic={urlTopic} baseUrl="/es/skills" />

    <SkillGrid skills={filteredSkills} locale={locale} />
  </div>
</BaseLayout>
