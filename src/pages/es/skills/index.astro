---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SkillGrid from '@/components/skills/SkillGrid.astro';
import { Badge } from '@/components/starwind/badge';
import { Separator } from '@/components/starwind/separator';
import { getAllSkills, getTopics, topicSlug } from '@/lib/skills';
import { t } from '@/lib/i18n';

const locale = 'es' as const;
const allSkills = await getAllSkills();
const topics = await getTopics();

const siteOrigin = Astro.site ?? new URL('https://front-skills.local');
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Front Skills Library',
  url: new URL('/es/skills', siteOrigin).toString(),
  hasPart: {
    '@type': 'ItemList',
    itemListElement: allSkills.map((skill, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: new URL(`/es/skills/${skill.data.slug}`, siteOrigin).toString(),
      name: skill.data.title,
    })),
  },
};
---

<BaseLayout
  title={`${t('skills.title', locale)} - Front Skills`}
  description="Explora todas las skills de frontend disponibles"
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <div class="container-page pt-24 pb-12">
    <h1 class="page-title">{t('skills.title', locale)}</h1>
    <p class="page-subtitle">
      <span data-topic-count>{allSkills.length}</span> {t('skills.countSuffix', locale)}
    </p>

    <div class="topic-filter mt-6 flex flex-wrap gap-2" data-topic-filter>
      <button type="button" data-topic-filter-btn="all" aria-pressed="true">
        <Badge variant="outline" size="md">
          {t('skills.all', locale)} ({allSkills.length})
        </Badge>
      </button>
      {topics.map(({ topic, count }) => (
        <button type="button" data-topic-filter-btn={topicSlug(topic)} aria-pressed="false">
          <Badge variant="outline" size="md">
            {topic} ({count})
          </Badge>
        </button>
      ))}
    </div>

    <Separator class="my-8" />

    <div data-topic-grid>
      <SkillGrid skills={allSkills} locale={locale} />
    </div>
  </div>
</BaseLayout>

<script>
  function initTopicFilter() {
    const root = document.querySelector('[data-topic-filter]');
    const grid = document.querySelector('[data-topic-grid]');
    const count = document.querySelector('[data-topic-count]');
    if (!root || !grid || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';

    const btns = Array.from(root.querySelectorAll('[data-topic-filter-btn]'));
    const cards = Array.from(grid.querySelectorAll('[data-topic-slugs]'));

    function apply(topic: string | null) {
      const active = topic && topic !== 'all' ? topic : 'all';
      btns.forEach((b) => {
        if (b instanceof HTMLElement) {
          b.setAttribute('aria-pressed', String(b.dataset.topicFilterBtn === active));
        }
      });
      let visible = 0;
      cards.forEach((c) => {
        if (!(c instanceof HTMLElement)) return;
        const show =
          active === 'all' || (c.dataset.topicSlugs || '').split(' ').includes(active);
        c.classList.toggle('hidden', !show);
        if (show) visible++;
      });
      if (count) count.textContent = String(visible);
      const url = new URL(window.location.href);
      if (active === 'all') {
        url.searchParams.delete('topic');
      } else {
        url.searchParams.set('topic', active);
      }
      const query = url.searchParams.toString();
      history.replaceState(null, '', url.pathname + (query ? `?${query}` : '') + url.hash);
    }

    btns.forEach((b) => {
      if (b instanceof HTMLElement) {
        b.addEventListener('click', () => apply(b.dataset.topicFilterBtn || 'all'));
      }
    });

    const initial = new URLSearchParams(window.location.search).get('topic');
    apply(btns.some((b) => b instanceof HTMLElement && b.dataset.topicFilterBtn === initial) ? initial : 'all');
  }

  initTopicFilter();
  document.addEventListener('astro:page-load', initTopicFilter);
</script>
