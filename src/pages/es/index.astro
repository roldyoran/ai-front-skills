---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SkillGrid from "@/components/skills/SkillGrid.astro";
import Icon from "@/components/ui/Icon.astro";
import { Button } from "@/components/starwind/button";
import {
  Accordion,
  AccordionItem,
  AccordionTrigger,
  AccordionContent,
} from "@/components/starwind/accordion";
import { getFeaturedSkills } from "@/lib/skills";
import { t } from "@/lib/i18n";

const locale = "es" as const;
const featuredSkills = await getFeaturedSkills();

const faqItems = [
  { q: t("home.faq.q1", locale), a: t("home.faq.a1", locale) },
  { q: t("home.faq.q2", locale), a: t("home.faq.a2", locale) },
  { q: t("home.faq.q3", locale), a: t("home.faq.a3", locale) },
];

const faqStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<BaseLayout title={t("site.title", locale)} description="AI Front Skills reutilizables para humanos y agentes de IA, con comparaciones visuales antes/después. Explora la biblioteca e instala cualquier skill en segundos.">
  <script type="application/ld+json" set:html={JSON.stringify(faqStructuredData)} />
  <!-- Hero -->
  <section class="pt-24 pb-12 sm:pt-32 sm:pb-16">
    <div class="container-page text-center">
      <h1 class="sr-only">AI Front Skills — skills de frontend con comparaciones visuales antes/después</h1>
      <pre
        class="mb-4 text-white text-[4px] sm:text-[5px] md:text-[7px] lg:text-[9px] font-mono leading-[110%] tracking-tight select-none">
 █████╗ ██╗    ███████╗██████╗  ██████╗ ███╗   ██╗████████╗    ███████╗██╗  ██╗██╗██╗     ██╗     ███████╗
██╔══██╗██║    ██╔════╝██╔══██╗██╔═══██╗████╗  ██║╚══██╔══╝    ██╔════╝██║ ██╔╝██║██║     ██║     ██╔════╝
███████║██║    █████╗  ██████╔╝██║   ██║██╔██╗ ██║   ██║       ███████╗█████╔╝ ██║██║     ██║     ███████╗
██╔══██║██║    ██╔══╝  ██╔══██╗██║   ██║██║╚██╗██║   ██║       ╚════██║██╔═██╗ ██║██║     ██║     ╚════██║
██║  ██║██║    ██║     ██║  ██║╚██████╔╝██║ ╚████║   ██║       ███████║██║  ██╗██║███████╗███████╗███████║
╚═╝  ╚═╝╚═╝    ╚═╝     ╚═╝  ╚═╝ ╚═════╝ ╚═╝  ╚═══╝   ╚═╝       ╚══════╝╚═╝  ╚═╝╚═╝╚══════╝╚══════╝╚══════╝
      </pre>

      <p class="mb-6 text-sm text-text-secondary max-w-md mx-auto">
        AI Front Skills es una colección de skills de ingeniería de diseño para ayudar a humanos y
        agentes a crear mejores interfaces.
      </p>

      <div class="flex flex-wrap justify-center gap-2">
        <Button as="a" href="/es/skills" size="md">
          {t("hero.cta", locale)}
          <Icon name="arrow-right" size={15} />
        </Button>
      </div>
    </div>
  </section>

  <!-- Featured -->
  <section class="pb-20">
    <div class="container-page">
      <div class="mb-6 flex items-center justify-between">
        <div>
          <h2 class="text-lg font-bold text-text">{t("skills.featured", locale)}</h2>
          <p class="mt-1 text-xs text-text-secondary">Skills con comparaciones visuales</p>
        </div>
        <Button as="a" href="/es/skills" variant="ghost" size="sm">
          {t("skills.viewAll", locale)}
          <Icon name="arrow-right" size={12} />
        </Button>
      </div>
      <SkillGrid skills={featuredSkills} locale={locale} variant="list" />
    </div>
  </section>

  <!-- FAQ -->
  <section class="pb-20">
    <div class="container-page">
      <h2 class="mb-4 text-lg font-bold text-text">{t("home.faqTitle", locale)}</h2>
      <Accordion type="single" collapsible defaultValue="faq-0">
        {faqItems.map((item, i) => (
          <AccordionItem value={`faq-${i}`}>
            <AccordionTrigger>{item.q}</AccordionTrigger>
            <AccordionContent>
              <p class="text-sm text-text-secondary leading-relaxed">{item.a}</p>
            </AccordionContent>
          </AccordionItem>
        ))}
      </Accordion>
    </div>
  </section>
</BaseLayout>
