---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Badge from '@/components/ui/Badge.astro';
import Icon from '@/components/ui/Icon.astro';
import ImageComparison from '@/components/svelte/ImageComparison.svelte';
import { getAllSkills, getCategoryInfo, renderMarkdown } from '@/lib/skills';

export async function getStaticPaths() {
  const skills = await getAllSkills();
  return skills.map((skill) => ({
    params: { slug: skill.data.slug },
    props: { skill },
  }));
}

const { skill } = Astro.props;
const locale = 'en' as const;
const { title, slug, category, description, comparison, author } = skill.data;

const categoryInfo = getCategoryInfo(category, locale);

// Render markdown body
const contentHtml = renderMarkdown(skill.body);

const installCommand = `npx skills add front-skills@${slug}`;
---

<BaseLayout
  title={`${title} - Front Skills`}
  description={description}
  type="article"
>
  <article class="container-page pt-24 pb-12">
    <!-- Breadcrumb -->
    <nav class="mb-6 text-xs text-text-dim">
      <a href="/" class="hover:text-text-secondary transition-colors">skills</a>
      <span class="mx-1.5 text-text-dim">/</span>
      <a href={`/skills?category=${category}`} class="hover:text-text-secondary transition-colors">{categoryInfo.label}</a>
      <span class="mx-1.5 text-text-dim">/</span>
      <span class="text-text-muted">{slug}</span>
    </nav>

    <!-- Header -->
    <header class="mb-6">
      <div class="flex items-center gap-2 mb-3">
        <a href={`/skills?category=${category}`} class="hover:opacity-80 transition-opacity">
          <Badge variant="category">
            <Icon name={categoryInfo.icon as any} size={11} class="mr-1" />
            {categoryInfo.label}
          </Badge>
        </a>
        <span class="text-[11px] text-text-dim">{author}</span>
      </div>

      <h1 class="text-2xl sm:text-3xl font-bold text-text tracking-tight mb-3">
        {title}
      </h1>

      <p class="text-sm text-text-secondary leading-relaxed">
        {description}
      </p>
    </header>

    <!-- Installation -->
    <section class="mb-8">
      <h2 class="mb-3 text-xs font-semibold text-text uppercase tracking-wider">Installation</h2>
      <div class="flex items-center gap-3 border border-border bg-surface px-4 py-3">
        <span class="text-text-dim text-sm">$</span>
        <code class="text-text text-sm font-mono flex-1 truncate">{installCommand}</code>
        <button
          data-copy={installCommand}
          class="copy-btn border border-border bg-bg-secondary px-3 py-1.5 text-xs text-text-secondary hover:text-text transition-colors flex items-center gap-1.5 shrink-0 cursor-pointer"
        >
          <Icon name="copy" size={14} />
          <span class="copy-label">Copy</span>
        </button>
      </div>
    </section>

    <!-- Summary -->
    <section class="mb-8">
      <h2 class="mb-3 text-xs font-semibold text-text uppercase tracking-wider">Summary</h2>
      <div class="text-sm text-text-secondary leading-relaxed">
        <p class="font-medium text-text mb-2">{description}</p>
      </div>
    </section>

    <!-- Comparison -->
    {comparison?.before && comparison?.after && (
      <section class="mb-8">
        <h2 class="mb-3 text-xs font-semibold text-text uppercase tracking-wider">Comparison</h2>
        <p class="mb-3 text-xs text-text-secondary">Drag to compare</p>
        <ImageComparison
          client:visible
          beforeSrc={comparison.before}
          afterSrc={comparison.after}
          beforeAlt={`${title} - Before`}
          afterAlt={`${title} - After`}
          width={800}
          height={500}
        />
      </section>
    )}

    <!-- SKILL.md Content -->
    {contentHtml && (
      <section class="mb-8">
        <h2 class="mb-4 text-xs font-semibold text-text uppercase tracking-wider">SKILL.md</h2>
        <div class="prose" set:html={contentHtml} />
      </section>
    )}
  </article>
</BaseLayout>

<script>
  document.querySelectorAll('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const command = btn.getAttribute('data-copy');
      if (!command) return;
      navigator.clipboard.writeText(command).then(() => {
        const label = btn.querySelector('.copy-label');
        if (label) label.textContent = 'Copied!';
        setTimeout(() => { if (label) label.textContent = 'Copy'; }, 2000);
      });
    });
  });
</script>
